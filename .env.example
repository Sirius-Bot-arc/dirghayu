# Dirghayu Environment Configuration
# Copy to .env.local for local development

# App
NEXT_PUBLIC_APP_NAME="Dirghayu"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_COOKIE_NAME="dirghayu_session"
AUTH_COOKIE_MAX_AGE="2592000" # 30 days
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
LOCKOUT_DURATION_MS="900000" # 15 minutes

# Firestore (optional for local dev)
FIRESTORE_ENABLED="false"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Gemini AI
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Email (Nodemailer SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Dirghayu <noreply@dirghayu.example>"
EMAIL_REPLY_TO="support@dirghayu.example"

# Cron
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Timezone
DEFAULT_TIMEZONE="Asia/Kolkata"

# Escalation timing (minutes)
ESCALATION_ELDER_TO_CARETAKER_MIN="30"
ESCALATION_CARETAKER_TO_FAMILY_MIN="60"

# Adherence
ADHERENCE_ON_TIME_WINDOW_MIN="30"
PDC_LOOKBACK_DAYS="90"